+    }
+
+    #[test]
+    fn an_owner_on_no_monitor_is_covered_unclipped() {
+        let placed = placement(rect(5000, 0, 600, 400), &[rect(0, 0, 1000, 800)]);
+        assert_eq!(placed.window, rect(5000, 0, 600, 400));
+    }
+
+    #[test]
