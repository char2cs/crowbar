+mod tests {
+    use super::*;
+
+    fn rect(x: i32, y: i32, width: i32, height: i32) -> Bounds<i32> {
+        Bounds::new(point(x, y), size(width, height))
+    }
+
+    fn link(owner: xproto::Window, takes_keys: bool) -> OverlayLink {
+        OverlayLink {
+            owner,
+            window: Bounds::default(),
+            owner_bounds: Bounds::default(),
+            takes_keys,
+            region: Vec::new(),
+        }
+    }
+
