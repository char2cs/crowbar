+    check_reply(
+        || "RandR SelectInput for monitor changes failed",
+        xcb_connection.randr_select_input(
+            root,
+            randr::NotifyMask::SCREEN_CHANGE
+                | randr::NotifyMask::CRTC_CHANGE
+                | randr::NotifyMask::OUTPUT_CHANGE,
+        ),
+    )?;
