+    /// instance; every other face goes through cosmic-text's cache unchanged.
+    fn glyph_image(&mut self, params: &RenderGlyphParams) -> Option<SwashImage> {
+        let loaded = &self.loaded_fonts[params.font_id.0];
+        let (font, weight) = (Arc::clone(&loaded.font), loaded.weight);
         let subpixel_shift = point(
             params.subpixel_variant.x as f32 / SUBPIXEL_VARIANTS_X as f32 / params.scale_factor,
             params.subpixel_variant.y as f32 / SUBPIXEL_VARIANTS_Y as f32 / params.scale_factor,
         );
+        let (key, _, _) = CacheKey::new(
+            font.id(),
+            params.glyph_id.0 as u16,
+            (params.font_size * params.scale_factor).into(),
+            (subpixel_shift.x, subpixel_shift.y.trunc()),
+            CacheKeyFlags::empty(),
+        );
+        let Some(weight) = weight else {
+            return self.swash_cache.get_image(&mut self.font_system, key).clone();
+        };
+        let mut scaler = self
+            .scale_context
+            .builder(font.as_swash())
+            .size(f32::from_bits(key.font_size_bits))
+            .hint(true)
+            .variations([("wght", f32::from(weight))])
+            .build();
+        Render::new(&[
+            Source::ColorOutline(0),
+            Source::ColorBitmap(StrikeWith::BestFit),
+            Source::Outline,
+        ])
+        .format(Format::Alpha)
+        .offset(Vector::new(key.x_bin.as_float(), key.y_bin.as_float()))
+        .render(&mut scaler, key.glyph_id)
+    }
+
+    /// The `FontId` that draws the face `base` at `weight`: variable faces get one entry per
+    /// requested weight, since gpui keys shaping and glyph caches by `FontId`.
+    fn with_weight(&mut self, base: FontId, weight: FontWeight) -> FontId {
+        let loaded = self.loaded_font(base);
+        let axis = tag_from_bytes(b"wght");
+        if loaded.weight.is_some() || loaded.font.as_swash().variations().find_by_tag(axis).is_none()
+        {
+            return base;
+        }
+        let (id, wght) = (loaded.font.id(), weight.0 as u16);
+        if let Some(ix) = self
+            .loaded_fonts
+            .iter()
+            .position(|font| font.font.id() == id && font.weight == Some(wght))
+        {
+            return FontId(ix);
+        }
+        let mut features = loaded.features.clone();
+        features.set(cosmic_text::FeatureTag::new(b"wght"), u32::from(wght));
+        let derived = LoadedFont {
+            font: Arc::clone(&loaded.font),
+            features,
+            is_known_emoji_font: loaded.is_known_emoji_font,
+            weight: Some(wght),
+        };
+        self.loaded_fonts.push(derived);
+        FontId(self.loaded_fonts.len() - 1)
+    }
