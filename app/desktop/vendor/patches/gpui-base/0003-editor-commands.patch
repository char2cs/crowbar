+    /// Scroll so the line holding `offset` sits in the middle of the viewport, as Monaco's
+    /// `revealPositionInCenter` does; the column is scrolled into view as a caret move does.
+    pub fn reveal_centered(&mut self, offset: usize, cx: &mut Context<Self>) {
+        self.scroll_to(offset, None, cx);
+        let (Some(layout), Some(bounds)) = (self.last_layout.as_ref(), self.last_bounds.as_ref())
+        else {
+            return;
+        };
+        let x = self.deferred_scroll_offset.map_or(px(0.), |offset| offset.x);
+        let line_height = layout.line_height;
+        let row = self
+            .display_map
+            .offset_to_display_row(offset, self.line_end_affinity_at(offset));
+        let centre = line_height * row - (bounds.size.height - line_height) / 2.;
+        let safe_y_min = (-self.scroll_size.height + self.input_bounds.size.height).min(px(0.));
+        let y = (-centre).clamp(safe_y_min, px(0.));
+        self.deferred_scroll_offset = Some(point(x, y));
+        cx.notify();
+    }
