+    /// Fold or unfold the candidate that starts at `start_line`; a line that starts no
+    /// candidate changes nothing.
+    pub fn set_folded(&mut self, start_line: usize, folded: bool, cx: &mut Context<Self>) {
+        if !self.display_map.is_fold_candidate(start_line) {
+            return;
+        }
+        self.display_map.set_folded(start_line, folded);
+        cx.notify();
+    }
