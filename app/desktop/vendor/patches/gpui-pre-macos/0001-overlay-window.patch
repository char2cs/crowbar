+/// The native window GPUI opened as `handle`.
+unsafe fn native_window_of(handle: AnyWindowHandle) -> Option<*mut AnyObject> {
+    unsafe {
+        let app: *mut AnyObject = msg_send![class!(NSApplication), sharedApplication];
+        let windows: *mut AnyObject = msg_send![app, windows];
+        let count: NSUInteger = msg_send![windows, count];
+        (0..count)
+            .map(|index| -> *mut AnyObject { msg_send![windows, objectAtIndex: index] })
+            .filter(|window| {
+                let is_gpui: Bool = msg_send![*window, isKindOfClass: WINDOW_CLASS];
+                is_gpui.as_bool()
+            })
+            .find(|window| get_window_state(&**window).lock().handle == handle)
+    }
