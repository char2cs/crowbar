+    check_reply(
+        || "X11 emptying the input region of an overlay failed.",
+        xcb.shape_rectangles(
+            shape::SO::SET,
+            shape::SK::INPUT,
+            xproto::ClipOrdering::UNSORTED,
+            x_window,
+            0,
+            0,
+            &[overlay::NOTHING],
+        ),
+    )?;
+    check_reply(
+        || "X11 placing an overlay failed.",
+        xcb.configure_window(
+            x_window,
+            &xproto::ConfigureWindowAux::new()
+                .x(x)
+                .y(y)
+                .width(width as u32)
+                .height(height as u32),
+        ),
+    )
+}
