+fn contains(rect: &xproto::Rectangle, at: Point<i32>) -> bool {
+    let (left, top) = (i32::from(rect.x), i32::from(rect.y));
+    at.x >= left && at.y >= top && at.x < left + i32::from(rect.width) && at.y < top + i32::from(rect.height)
 }
 
