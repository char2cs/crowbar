+    #[test]
+    fn without_a_compositor_what_the_overlay_paints_holds_the_pointer() {
+        let mut held = link(1, false);
+        held.window = rect(100, 50, 400, 300);
+        held.content = vec![rectangle(10, 20, 30, 40)];
