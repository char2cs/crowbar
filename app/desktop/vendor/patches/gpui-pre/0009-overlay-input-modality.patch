+    /// Redraws this window and every window sharing its input modality: its owner and the
+    /// owner's overlays.
+    fn refresh_modality_sharers(&mut self, cx: &mut App) {
+        self.refresh();
+        let owner = self.overlay_of.unwrap_or(self.handle);
+        for window in cx.windows.values_mut().flatten() {
+            if window.handle == owner || window.overlay_of == Some(owner) {
+                window.refresh();
+            }
+        }
+    }
