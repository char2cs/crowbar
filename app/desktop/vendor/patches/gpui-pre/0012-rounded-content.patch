+/// `bounds` with its rounded corners left out, in device pixels: a rectangle per pixel row the
+/// corner arcs cut, and one for the rows between them. A pixel shows when the arc covers its
+/// centre, so without a compositor a rounded card shows no black square corners.
+fn rounded_rows(
+    bounds: Bounds<ScaledPixels>,
+    radii: &Corners<ScaledPixels>,
+) -> Vec<Bounds<ScaledPixels>> {
+    let (width, height) = (bounds.size.width.0, bounds.size.height.0);
+    let limit = width.min(height) / 2.0;
+    let radius = |corner: ScaledPixels| corner.0.clamp(0.0, limit);
+    let (top_left, top_right) = (radius(radii.top_left), radius(radii.top_right));
+    let (bottom_left, bottom_right) = (radius(radii.bottom_left), radius(radii.bottom_right));
+    let top = top_left.max(top_right).ceil().min(height);
+    let bottom = bottom_left.max(bottom_right).ceil().min(height - top);
+    if top == 0.0 && bottom == 0.0 {
+        return vec![bounds];
+    }
+    let inset = |radius: f32, from_edge: f32| {
+        let rise = radius - from_edge;
+        if rise <= 0.0 {
+            return 0.0;
+        }
+        (radius - (radius * radius - rise * rise).max(0.0).sqrt()).round()
+    };
+    let row = |y: f32, rows: f32, (left, right): (f32, f32)| {
+        Bounds::new(
+            point(ScaledPixels(bounds.origin.x.0 + left), ScaledPixels(bounds.origin.y.0 + y)),
+            size(ScaledPixels((width - left - right).max(0.0)), ScaledPixels(rows)),
+        )
+    };
+    let mut rows = Vec::new();
+    for index in 0..top as usize {
+        let from_top = index as f32 + 0.5;
+        let insets = (inset(top_left, from_top), inset(top_right, from_top));
+        rows.push(row(index as f32, 1.0, insets));
+    }
+    rows.push(row(top, height - top - bottom, (0.0, 0.0)));
+    for index in 0..bottom as usize {
+        let from_bottom = index as f32 + 0.5;
+        let insets = (inset(bottom_left, from_bottom), inset(bottom_right, from_bottom));
+        rows.push(row(height - index as f32 - 1.0, 1.0, insets));
+    }
+    rows
+}
