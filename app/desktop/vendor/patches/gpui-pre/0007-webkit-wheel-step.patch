+
+
+// The X11 and Wayland platforms report a wheel click as this many lines.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+const WHEEL_CLICK_LINES: f32 = 3.0;
+
+/// The pixels a wheel line scrolls. On Linux a click scrolls `pow(h, 2/3)` pixels of a window `h`
+/// high, as WebKitGTK's `Scrollbar::pixelsPerLineStep` does; elsewhere one line is the line height.
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+fn wheel_line_step(window: &Window) -> Pixels {
+    let height = f32::from(window.viewport_size().height);
+    px(height.powf(2.0 / 3.0).floor() / WHEEL_CLICK_LINES)
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "freebsd")))]
+fn wheel_line_step(window: &Window) -> Pixels {
+    window.line_height()
+}
