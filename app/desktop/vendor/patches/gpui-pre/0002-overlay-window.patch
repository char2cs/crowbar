+        FileDropEvent::Submit { position } => FileDropEvent::Submit {
+            position: *position - origin,
+        },
+        FileDropEvent::Exited => FileDropEvent::Exited,
+        FileDropEvent::Ended => FileDropEvent::Ended,
+    }
+}
