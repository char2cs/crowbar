+    /// The `FontId` that draws the face `base` at `weight`: variable faces get one entry per
+    /// requested weight, since gpui keys shaping and glyph caches by `FontId`.
+    fn with_weight(&mut self, base: FontId, weight: FontWeight) -> FontId {
+        let loaded = self.loaded_font(base);
+        let axis = swash::tag_from_bytes(b"wght");
+        if loaded.weight.is_some() || loaded.font.as_swash().variations().find_by_tag(axis).is_none()
+        {
+            return base;
+        }
+        let (id, wght) = (loaded.font.id(), weight.0 as u16);
+        let derived = LoadedFont {
+            font: Arc::clone(&loaded.font),
+            features: loaded.features.clone(),
+            is_known_emoji_font: loaded.is_known_emoji_font,
+            user_fallback_chain: Arc::clone(&loaded.user_fallback_chain),
+            weight: Some(wght),
+            fake_italic: false,
+        };
+        self.derived_font(id, derived)
+    }
+
+    /// The `FontId` that draws `upright` slanted, for an italic asked of a family that has no
+    /// italic face (as browsers synthesize one). gpui keys glyph caches by `FontId`.
+    fn with_fake_italic(&mut self, upright: FontId) -> FontId {
+        let loaded = self.loaded_font(upright);
+        let id = loaded.font.id();
+        let derived = LoadedFont {
+            font: Arc::clone(&loaded.font),
+            features: loaded.features.clone(),
+            is_known_emoji_font: loaded.is_known_emoji_font,
+            user_fallback_chain: Arc::clone(&loaded.user_fallback_chain),
+            weight: loaded.weight,
+            fake_italic: true,
+        };
+        self.derived_font(id, derived)
+    }
+
+    fn derived_font(&mut self, id: cosmic_text::fontdb::ID, derived: LoadedFont) -> FontId {
+        if let Some(ix) = self.loaded_fonts.iter().position(|font| {
+            font.font.id() == id
+                && font.weight == derived.weight
+                && font.fake_italic == derived.fake_italic
+                && font.features == derived.features
+        }) {
+            return FontId(ix);
+        }
+        self.loaded_fonts.push(derived);
+        FontId(self.loaded_fonts.len() - 1)
+    }
