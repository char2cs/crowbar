{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crowbar",
  "version": "0.0.0",
  "identifier": "software.rabbyte.crowbar",
  "build": {
    "frontendDist": "../../panes/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../panes && npm run dev -- --port 5173 --strictPort",
    "beforeBuildCommand": "bash \"$(git rev-parse --show-toplevel)/app/mobile/icons-compiler/compile-icon.sh\""
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    },
    "windows": [
      {
        "title": "Crowbar",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 23
        },
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "plugins": {
    "macos-fps": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/crowbar-api"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  }
}
