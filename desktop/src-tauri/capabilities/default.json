{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default app capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{"name": "crowbar-api", "sidecar": true, "args": true}]
    },
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-open",
    "log:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}
