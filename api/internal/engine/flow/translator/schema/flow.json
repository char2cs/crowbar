{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "states"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "item_statuses": {
      "type": "array",
      "items": {"type": "string"}
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "terminal": {"type": "boolean"},
          "ui": {
            "type": "string",
            "enum": ["chat", "kanban", "diff", "background"]
          },
          "items": {"type": "boolean"},
          "agent": {
            "type": "object",
            "properties": {
              "intelligence": {
                "type": "string",
                "enum": ["low", "medium", "high", "ultrahigh"]
              },
              "tools": {
                "type": "array",
                "items": {"type": "string"}
              },
              "system_prompt": {"type": "string"}
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["to", "on"],
              "properties": {
                "to": {"type": "string"},
                "on": {"type": "string"}
              }
            }
          },
          "emits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "agent": {"type": "string"},
                "on": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
