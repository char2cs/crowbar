#!/usr/bin/env python3
"""The rig's stand-in forge CLI. The daemon reads pull-request state through the forge's own CLI,
picked by the origin URL, and this is the name it runs for a URL containing "gitlab"; the seed's
remote is a local bare repo whose path says so. Answers only the calls the daemon makes, from
~/fixtures/forge/merge-requests.json (written by seed/full.py). Signed out when
~/fixtures/forge/signed-out exists. Stdlib only."""
import json
import os
import sys

STATE = os.path.expanduser(os.environ.get("RIG_FORGE_DIR", "~/fixtures/forge"))


def flag(args, name, default=None):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else default


def main(args):
    if args[:2] == ["auth", "status"]:
        if os.path.exists(os.path.join(STATE, "signed-out")):
            print("rig-forge: not logged in", file=sys.stderr)
            return 1
        print("Logged in to rig-forge as rig (fixture)", file=sys.stderr)
        return 0
    try:
        with open(os.path.join(STATE, "merge-requests.json")) as f:
            fixture = json.load(f)
    except OSError:
        fixture = {"protected": ["main"], "merge_requests": []}
    if args[:1] == ["api"]:
        if args[1].endswith("protected_branches"):
            print("\n".join(fixture.get("protected", ["main"])))
        else:
            print("")
        return 0
    if args[:2] == ["mr", "list"]:
        mrs = fixture.get("merge_requests", [])
        source, state = flag(args, "--source-branch"), flag(args, "--state", "all")
        if source:
            mrs = [m for m in mrs if m["source_branch"] == source]
        if state != "all":
            mrs = [m for m in mrs if m["state"] == state]
        print(json.dumps(mrs))
        return 0
    print(f"rig-forge: unsupported call {args}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
