#!/bin/bash
# Drives the Tauri app (develop) and the Rust shell (this branch) side by side. See README.md.
set -euo pipefail
export DISPLAY=${DISPLAY:-:1}
RIG_W=${RIG_W:-1280} RIG_H=${RIG_H:-800} RIG_GAP=${RIG_GAP:-20}
RIG_DIR=$HOME/.rig
SHOTS=${RIG_SHOTS:-$HOME/shots}
RIGX=/opt/rig/bin/rigx.py
PROFILES=/opt/rig/profiles
HTTP_PORT=${RIG_HTTP_PORT:-8088}
REMOTE_HOME=$HOME/.crowbar-remote
REMOTE_PORT=${RIG_REMOTE_PORT:-4747}
TAURI_DB=$HOME/.local/share/software.rabbyte.crowbar/localstorage/tauri_localhost_0.localstorage
RUST_SETTINGS=$CROWBAR_HOME/shell/settings.json
# shellcheck source=points.conf
source /opt/rig/points.conf
[[ -f $RIG_DIR/points.conf ]] && source "$RIG_DIR/points.conf"

die() { echo "rig: $*" >&2; exit 1; }
apps_of() {
  case ${1:-all} in
    all) echo tauri rust ;;
    tauri | rust) echo "$1" ;;
    *) die "unknown app '$1' (tauri, rust or all)" ;;
  esac
}
one_app() { [[ ${1:-} == tauri || ${1:-} == rust ]] || die "name one app: tauri or rust"; }
cmd_of() {
  case $1 in
    tauri) echo /usr/bin/crowbar-desktop ;;
    rust) echo /opt/crowbar/crowbar ;;
  esac
}
slot_x() { [[ $1 == tauri ]] && echo 0 || echo $((RIG_W + RIG_GAP)); }
pid_of() {
  local pid
  pid=$(cat "$RIG_DIR/$1/pid" 2>/dev/null) || return 1
  [[ -d /proc/$pid ]] && grep -qF "$(cmd_of "$1")" "/proc/$pid/cmdline" 2>/dev/null && echo "$pid"
}
running() { pid_of "$1" >/dev/null; }
socket() { /opt/crowbar/crowbar-api.real paths | python3 -c 'import json,sys; print(json.load(sys.stdin)["socket"])'; }

winid() { # the app's largest visible window carrying its _NET_WM_PID (both apps set it)
  local pid w g best="" area=0
  # return, not die: wait_window polls this before the forked shell has exec'd the app
  pid=$(pid_of "$1") || { echo "rig: $1 is not running" >&2; return 1; }
  for w in $(xdotool search --onlyvisible --pid "$pid" 2>/dev/null); do
    g=$(xdotool getwindowgeometry "$w" 2>/dev/null | awk '/Geometry/ {print $2}')
    [[ $g == *x* ]] || continue # the window went away since the search
    ((${g%x*} * ${g#*x} > area)) && area=$((${g%x*} * ${g#*x})) && best=$w
  done
  ((area > 0)) || return 1
  echo "$best"
}

# min_size <app>: the minimum the app declares in WM_NORMAL_HINTS, else $RIG_MIN (the Rust shell's).
min_size() {
  local hint
  hint=$(xprop -id "$(winid "$1")" WM_NORMAL_HINTS | sed -n 's/.*minimum size: \([0-9]*\) by \([0-9]*\).*/\1x\2/p')
  if [[ -n $hint && $hint != 0x0 && $hint != 1x1 ]]; then echo "$hint"; return; fi
  echo "$1 declares no minimum size; using RIG_MIN=${RIG_MIN:-640x480}" >&2
  echo "${RIG_MIN:-640x480}"
}

wait_window() {
  local i pid
  pid=$(cat "$RIG_DIR/$1/pid")
  for i in $(seq 600); do
    winid "$1" 2>/dev/null && return
    [[ -d /proc/$pid ]] || die "$1 exited during startup; see $RIG_DIR/$1/app.log"
    sleep 0.1
  done
  die "$1 opened no window in 60s; see $RIG_DIR/$1/app.log"
}

place() { # place <app> <w> <h>
  local w
  w=$(winid "$1") || die "$1 has no window"
  xdotool windowmove "$w" "$(slot_x "$1")" 0 windowsize "$w" "$2" "$3"
  local i g
  for i in $(seq 50); do
    g=$(xdotool getwindowgeometry "$w" | awk '/Geometry/ {print $2}')
    [[ $g == "$2x$3" ]] && break
    sleep 0.1
  done
  # The client rectangle (inside openbox's border), which `perf startup` samples before a window exists.
  local X Y WIDTH HEIGHT WINDOW SCREEN
  eval "$(xdotool getwindowgeometry --shell "$w")"
  echo "$X,$Y,$WIDTH,$HEIGHT" >"$RIG_DIR/$1/rect"
  echo "$1 $X,$Y ${WIDTH}x$HEIGHT"
}

start_app() {
  local app=$1 cmd
  running "$app" && { echo "$app is already running (pid $(pid_of "$app"))"; return; }
  mkdir -p "$RIG_DIR/$app"
  cmd=$(cmd_of "$app")
  (
    cd "$HOME"
    exec setsid env $(app_env) RIG_APP="$app" "$cmd" >>"$RIG_DIR/$app/app.log" 2>&1 </dev/null
  ) &
  echo $! >"$RIG_DIR/$app/pid"
  if [[ ${RIG_NO_PLACE:-} == 1 ]]; then return; fi
  wait_window "$app" >/dev/null
  place "$app" "$RIG_W" "$RIG_H" >/dev/null
  echo "$app started (pid $(pid_of "$app"))"
}

# app_env: the env(1) arguments `rig a11y`, `rig ime` and `rig motion` leave in $RIG_DIR/app.env for
# the next app start ("NAME=value" sets, "-u NAME" unsets).
app_env() { # env(1) takes its -u options before any assignment
  [[ -f $RIG_DIR/app.env ]] || return 0
  { grep '^-u ' "$RIG_DIR/app.env"; grep -v -e '^-u ' -e '^#' "$RIG_DIR/app.env"; } | tr '\n' ' '; true
}
env_set() { # env_set <NAME> [value]: no value unsets NAME for the apps
  local tmp
  tmp=$(mktemp)
  grep -v -e "^$1=" -e "^-u $1\$" "$RIG_DIR/app.env" 2>/dev/null >"$tmp" || true
  if (($# > 1)); then echo "$1=$2" >>"$tmp"; else echo "-u $1" >>"$tmp"; fi
  mv "$tmp" "$RIG_DIR/app.env"
}
env_clear() { [[ -f $RIG_DIR/app.env ]] && sed -i -e "/^$1=/d" -e "/^-u $1\$/d" "$RIG_DIR/app.env"; true; }

stop_app() {
  local app=$1 pid i
  pid=$(pid_of "$app") || { echo "$app is not running"; return; }
  kill -TERM "$pid" 2>/dev/null || true
  for i in $(seq 100); do [[ -d /proc/$pid ]] || break; sleep 0.1; done
  kill -KILL -- "-$pid" 2>/dev/null || true
  rm -f "$RIG_DIR/$app/pid"
  echo "$app stopped"
}

# bus_up: the session bus (file-chooser portal, ibus, AT-SPI), started once; the apps get its address.
bus_up() {
  if [[ -f $RIG_DIR/bus.env ]] && kill -0 "$(sed -n 's/^PID=//p' "$RIG_DIR/bus.env")" 2>/dev/null; then return; fi
  local out
  out=$(dbus-daemon --session --fork --print-address=1 --print-pid=1)
  { echo "ADDR=$(sed -n 1p <<<"$out")"; echo "PID=$(sed -n 2p <<<"$out")"; } >"$RIG_DIR/bus.env"
  env_set DBUS_SESSION_BUS_ADDRESS "$(sed -n 1p <<<"$out")"
}

# with_stopped <apps> -- <command...>: stop the running ones, run the command, restart them.
with_stopped() {
  local apps=() was=() app
  while [[ $1 != -- ]]; do apps+=("$1"); shift; done
  shift
  for app in "${apps[@]}"; do running "$app" && was+=("$app") && stop_app "$app" >/dev/null; done
  "$@"
  for app in "${was[@]}"; do start_app "$app"; done
}

# WebKit discards a localStorage database it did not create itself, so let Tauri create it once.
tauri_db_ready() {
  [[ -f $TAURI_DB ]] && return
  start_app tauri >/dev/null
  for _ in $(seq 300); do [[ -f $TAURI_DB ]] && break; sleep 0.1; done
  sleep 2
  stop_app tauri >/dev/null
  [[ -f $TAURI_DB ]] || die "Tauri did not create its localStorage at $TAURI_DB"
}

set_setting() { # set_setting <key> <value> <apps...>
  local key=$1 value=$2 app
  shift 2
  for app; do
    case $app in
      tauri) tauri_db_ready && python3 "$RIGX" tauri-set "$TAURI_DB" "$key" "$value" ;;
      rust) python3 "$RIGX" rust-set "$RUST_SETTINGS" "$key" "$value" ;;
    esac
    echo "$app: $key = $value"
  done
}

shot() { # shot <app> <file>
  local w
  w=$(winid "$1") || die "$1 has no window"
  xdotool windowraise "$w"
  python3 "$RIGX" shot "$w" "$2" >/dev/null
  echo "$2"
}

activate() {
  local w
  w=$(winid "$1") || die "$1 has no window"
  xdotool windowactivate --sync "$w" 2>/dev/null || xdotool windowfocus --sync "$w"
  echo "$w"
}

point() { # point <app> <name>  -> "x,y" from points.conf
  local var="${1}_$2"
  [[ -n ${!var:-} ]] || die "no point '$2' for $1: set ${var}=x,y in $RIG_DIR/points.conf"
  echo "${!var}"
}

click_point() { # click_point <app> <name>: click a points.conf point in the app's window
  local w xy
  w=$(activate "$1")
  xy=$(point "$1" "$2")
  xdotool mousemove --window "$w" "${xy%,*}" "${xy#*,}" click 1
}

# init: the state every comparison starts from — same theme and sidebar side in both apps, both
# seeded chats open as tabs with "Perf fixture" active (both apps restore their tabs on restart).
initial_settings() {
  set_setting themeMode "${RIG_THEME:-dark}" tauri rust
  set_setting sidebarPosition left tauri rust
}
init() {
  local app
  with_stopped tauri rust -- initial_settings
  for app in tauri rust; do running "$app" || start_app "$app"; done
  # points.conf names the baseline's sidebar rows (noproviders shares them); the other profiles
  # start on what each app restores.
  if [[ $(profile) == baseline || $(profile) == noproviders ]]; then
    for app in tauri rust; do
      click_point "$app" perf_chat; sleep 3
      click_point "$app" untitled_chat; sleep 3
      click_point "$app" switch_a; sleep 1
    done
  fi
  touch "$RIG_DIR/initialised"
}

profile() { cat "$RIG_DIR/profile" 2>/dev/null || echo "${RIG_PROFILE:-baseline}"; }

# extract_profile <name>: that profile's daemon home, scripted-agent state and ~/fixtures, as built.
extract_profile() {
  [[ -f $PROFILES/$1.tar ]] || die "no profile '$1' (have: $(cd "$PROFILES" && ls *.tar | sed 's/\.tar$//' | xargs))"
  chmod -R u+rwX "$CROWBAR_HOME" "$HOME/fixtures" 2>/dev/null || true
  rm -rf "$CROWBAR_HOME" "$HOME/.scripted-agent" "$HOME/fixtures" "$HOME/.rig-unreadable"
  tar -S -xf "$PROFILES/$1.tar" -C "$HOME"
  [[ -f $HOME/.rig-unreadable ]] && (cd "$HOME" && xargs -r -d '\n' chmod 000 <"$HOME/.rig-unreadable")
  echo "$1" >"$RIG_DIR/profile"
}

# seed_profile <name>: both apps stopped, the daemon paused, the profile restored, both apps'
# own storage wiped, then `init`. `rig reset` is this with the current profile.
seed_profile() {
  stop_app tauri
  stop_app rust
  daemon_stop >/dev/null
  remote_stop
  rm -rf "$REMOTE_HOME" "$HOME/remote-host"
  rm -rf "$HOME/.local/share/software.rabbyte.crowbar" "$HOME/.cache/software.rabbyte.crowbar" "$RIG_DIR/initialised"
  extract_profile "$1"
  daemon_start >/dev/null
  "$0" _wait-daemon
  init
}
reset_state() { seed_profile "$(profile)"; }

# The paired-host daemon (`rig remote`): its own home and TLS listener, no supervisor loop, so a
# stop is a host that is down until started again.
remote() { CROWBAR_HOME=$REMOTE_HOME "$@"; }
remote_addresses() { # every address the remote host answers on
  local a=(127.0.0.1:$REMOTE_PORT localhost:$REMOTE_PORT) ip
  for ip in $(hostname -I 2>/dev/null); do a+=("$ip:$REMOTE_PORT"); done
  echo "${a[*]}"
}
remote_pid() { pgrep -f "crowbar-api.real serve --host tcp://:$REMOTE_PORT"; }
remote_start() {
  remote_pid >/dev/null && return
  local fresh=
  [[ -d $REMOTE_HOME/state ]] || fresh=1
  (cd "$HOME" && CROWBAR_HOME=$REMOTE_HOME exec setsid /opt/crowbar/crowbar-api.real serve --host "tcp://:$REMOTE_PORT" \
    >>"$RIG_DIR/remote.log" 2>&1 </dev/null) &
  remote python3 -c 'import sys; sys.path.insert(0, "/opt/rig/bin"); import rigapi; rigapi.Api().healthy(30)'
  [[ -z $fresh ]] || remote python3 /opt/rig/seed/remote.py
}
remote_stop() {
  pkill -f "crowbar-api.real serve --host tcp://:$REMOTE_PORT" || true
  while remote_pid >/dev/null; do sleep 0.2; done
}

daemon_stop() {
  touch "$RIG_DIR/daemon.paused"
  pkill -CONT -f "crowbar-api.real serve --host unix" || true
  pkill -f "crowbar-api.real serve --host unix" || true
  while pgrep -f "crowbar-api.real serve --host unix" >/dev/null; do sleep 0.2; done
  echo "daemon stopped (the apps see it gone; \`rig daemon start\` brings it back)"
}
daemon_start() {
  rm -f "$RIG_DIR/daemon.paused" "$RIG_DIR/daemon.crashloop"
  echo "daemon starting"
}
# daemon_path: the shared daemon's PATH; `rig daemon nogit` drops the one directory holding git
# (the image keeps git only there, so the daemon's fallback to /usr/bin finds none either).
daemon_path() {
  if [[ -e $RIG_DIR/daemon.nogit ]]; then tr : '\n' <<<"$PATH" | grep -vx /opt/rig/git-bin | paste -sd:; else echo "$PATH"; fi
}

# chooser <app>: the open file-chooser window — Tauri's own GTK dialog, or the portal's (GTK) dialog
# that the Rust shell asks xdg-desktop-portal for — the largest visible window of that process
# other than the app's own.
chooser() {
  local pid main="" w g best="" area=0
  if [[ $1 == tauri ]]; then
    pid=$(pid_of tauri) || return 1
    main=$(winid tauri)
  else
    pid=$(pgrep -f /usr/libexec/xdg-desktop-portal-gtk | head -1) || return 1
  fi
  for w in $(xdotool search --onlyvisible --pid "$pid" 2>/dev/null); do
    [[ $w == "$main" ]] && continue
    g=$(xdotool getwindowgeometry "$w" 2>/dev/null | awk '/Geometry/ {print $2}')
    [[ $g == *x* ]] || continue # the window went away since the search
    ((${g%x*} * ${g#*x} > area)) && area=$((${g%x*} * ${g#*x})) && best=$w
  done
  ((area > 0)) && echo "$best"
}

# pick <app> <path>: types the path into the open chooser's location bar and confirms it. The
# chooser opens on "Recent", where Enter on a typed path does nothing: alt+Home leaves it first. A
# folder chooser may only enter the folder on the first Enter; the second one selects it.
pick() {
  local w="" i
  for i in $(seq 100); do w=$(chooser "$1") && break; sleep 0.1; done
  [[ -n $w ]] || die "no file chooser is open for $1"
  xdotool windowactivate --sync "$w" 2>/dev/null || xdotool windowfocus --sync "$w"
  xdotool key --clearmodifiers alt+Home
  sleep 0.3
  xdotool key --clearmodifiers ctrl+l
  sleep 0.3
  xdotool key --clearmodifiers ctrl+a
  xdotool type --delay 20 "$2"
  sleep 0.3
  for i in 1 2 3; do
    xdotool windowfocus --sync "$w" 2>/dev/null || break
    xdotool key --clearmodifiers Return
    for _ in $(seq 20); do xdotool getwindowname "$w" >/dev/null 2>&1 && chooser "$1" >/dev/null || break 2; sleep 0.1; done
  done
  chooser "$1" >/dev/null && die "the chooser is still open: $2 was not accepted (rig shot cannot see it; check noVNC)"
  echo "$1: picked $2"
}

# fault rules for rig-proxy.py: one JSON object per line in $RIG_DIR/faults, reloaded on SIGUSR1.
fault_signal() { pkill -USR1 -f /opt/rig/bin/rig-proxy.py || true; }
fault_add() { # fault_add <method> <path-regex> <status|drop|delay> [ms]
  local action=$3 value=null
  case $3 in
    drop) ;;
    delay) value=${4:?fault <method> <path-regex> delay <ms>}; [[ $value =~ ^[0-9]+$ ]] || die "delay takes milliseconds" ;;
    [1-5][0-9][0-9]) action=status value=$3 ;;
    *) die "fault <method> <path-regex> <status|drop|delay ms>" ;;
  esac
  python3 -c 'import json, re, sys
m, path, action, value = sys.argv[1:]
re.compile(path)
print(json.dumps({"method": "*" if m.upper() in ("*", "ANY") else m.upper(), "path": path, "action": action, "value": json.loads(value)}))' \
    "$1" "$2" "$action" "$value" >>"$RIG_DIR/faults" || die "bad fault rule"
  fault_signal
}

# perf_one <metric> <app> [extra rigx args]: the other app is stopped while one is measured.
perf_one() {
  local metric=$1 app=$2 other
  shift 2
  other=$([[ $app == tauri ]] && echo rust || echo tauri)
  local other_was=0
  if [[ ${RIG_KEEP_OTHER:-0} != 1 ]] && running "$other"; then other_was=1; stop_app "$other" >/dev/null; fi
  case $metric in
    startup)
      stop_app "$app" >/dev/null
      rect=$(cat "$RIG_DIR/$app/rect" 2>/dev/null || echo "$(slot_x "$app"),0,$RIG_W,$RIG_H")
      python3 "$RIGX" startup "$app" --slot "$rect" "$@"
      ;;
    input)
      running "$app" || start_app "$app" >/dev/null
      click_point "$app" switch_a
      python3 "$RIGX" input "$app" --focus "$(point "$app" composer)" "$@"
      ;;
    switch)
      running "$app" || start_app "$app" >/dev/null
      activate "$app" >/dev/null
      python3 "$RIGX" switch "$app" --a "$(point "$app" switch_a)" --b "$(point "$app" switch_b)" "$@"
      ;;
    scroll)
      running "$app" || start_app "$app" >/dev/null
      click_point "$app" switch_a
      python3 "$RIGX" scroll "$app" --at "$(point "$app" scroll)" "$@"
      ;;
    idle)
      running "$app" || start_app "$app" >/dev/null
      python3 "$RIGX" idle "$app" --pid "$(pid_of "$app")" "$@"
      ;;
    memory)
      stop_app "$app" >/dev/null
      start_app "$app" >/dev/null
      activate "$app" >/dev/null
      python3 "$RIGX" memory "$app" --pid "$(pid_of "$app")" --focus "$(point "$app" switch_a)" "$@"
      # Both apps persist the tabs it opened and a terminal swallows mod+w: put the seeded state back.
      [[ ${RIG_NO_RESET:-0} == 1 ]] || reset_state >/dev/null
      ;;
    *) die "unknown metric '$metric'" ;;
  esac
  ((other_was)) && start_app "$other" >/dev/null
  return 0
}

usage() {
  sed -n '/^## Driver/,/^## Performance/p' /opt/rig/README.md 2>/dev/null | grep '^    rig' || true
}

sub=${1:-help}
shift || true
case $sub in
  status)
    for app in tauri rust; do
      if running "$app"; then
        w=$(winid "$app" 2>/dev/null || echo none)
        printf '%-6s running pid %s window %s %s\n' "$app" "$(pid_of "$app")" "$w" \
          "$([[ $w != none ]] && xdotool getwindowgeometry "$w" | awk '/Position|Geometry/ {printf "%s ", $2}')"
      else
        printf '%-6s stopped\n' "$app"
      fi
    done
    printf 'daemon %s\n' "$(python3 "$RIGX" health "$(socket)" 2>&1)"
    ;;
  start) for app in $(apps_of "${1:-all}"); do start_app "$app"; done ;;
  stop) for app in $(apps_of "${1:-all}"); do stop_app "$app"; done ;;
  restart) for app in $(apps_of "${1:-all}"); do stop_app "$app"; start_app "$app"; done ;;
  init) init ;;
  winid) one_app "${1:-}"; winid "$1" ;;
  size)
    for app in $(apps_of "${1:-all}"); do
      case ${2:-standard} in
        standard) place "$app" "$RIG_W" "$RIG_H" ;;
        default) [[ $app == tauri ]] && place "$app" 1200 800 || place "$app" 1280 800 ;;
        min) m=$(min_size "$app") && place "$app" "${m%x*}" "${m#*x}" ;;
        *x*) place "$app" "${2%x*}" "${2#*x}" ;;
        *) die "size: standard, default, min or WxH" ;;
      esac
    done
    ;;
  theme)
    [[ ${1:-} == light || ${1:-} == dark || ${1:-} == system ]] || die "theme light|dark|system [app|all]"
    read -ra targets <<<"$(apps_of "${2:-all}")"
    with_stopped "${targets[@]}" -- set_setting themeMode "$1" "${targets[@]}"
    ;;
  sidebar)
    [[ ${1:-} == left || ${1:-} == right ]] || die "sidebar left|right [app|all]"
    read -ra targets <<<"$(apps_of "${2:-all}")"
    with_stopped "${targets[@]}" -- set_setting sidebarPosition "$1" "${targets[@]}"
    ;;
  key)
    one_app "${1:-}"
    w=$(activate "$1")
    shift
    # XTest to the focused window: WebKit ignores synthetic (XSendEvent) key events.
    xdotool key --clearmodifiers "$@"
    ;;
  type)
    one_app "${1:-}"
    w=$(activate "$1")
    xdotool type --delay 30 "$2"
    ;;
  click)
    one_app "${1:-}"
    w=$(activate "$1")
    xdotool mousemove --window "$w" "$2" "$3" click "${4:-1}"
    ;;
  scroll)
    one_app "${1:-}"
    w=$(activate "$1")
    [[ ${4:-down} == up ]] && b=4 || b=5
    xdotool mousemove --window "$w" "$2" "$3" click --repeat "${5:-5}" --delay 50 "$b"
    ;;
  shot)
    one_app "${1:-}"
    mkdir -p "$SHOTS"
    shot "$1" "${2:-$SHOTS/$1-$(date +%H%M%S).png}"
    ;;
  pair)
    row=${1:?pair <row-id>}
    mkdir -p "$SHOTS/$row"
    shot tauri "$SHOTS/$row/tauri.png" >/dev/null
    shot rust "$SHOTS/$row/rust.png" >/dev/null
    python3 "$RIGX" compose "$SHOTS/$row/tauri.png" "$SHOTS/$row/rust.png" \
      "Tauri (develop)" "Rust shell (branch)" "$SHOTS/$row/side-by-side.png" >/dev/null
    ls "$SHOTS/$row"/*.png
    ;;
  perf)
    metric=${1:?perf <startup|input|switch|scroll|idle|memory|all> <app|all> [options]}
    shift
    targets=$(apps_of "${1:-all}")
    shift || true
    [[ $metric == all ]] && metrics="startup input switch scroll idle memory" || metrics=$metric
    for m in $metrics; do for app in $targets; do perf_one "$m" "$app" "$@"; done; done
    ;;
  daemon)
    case ${1:-status} in
      status) python3 "$RIGX" health "$(socket)" ;;
      stop) daemon_stop ;;
      start) daemon_start; "$0" _wait-daemon && echo "daemon up" ;;
      restart) rm -f "$RIG_DIR/daemon.paused"; pkill -f "crowbar-api.real serve --host unix" || true; echo "daemon restarting" ;;
      kill) pkill -KILL -f "crowbar-api.real serve --host unix" || true; echo "daemon killed (the loop respawns it)" ;;
      wedge) # alive with its socket open, answering nothing (SIGSTOP)
        pkill -STOP -f "crowbar-api.real serve --host unix"; echo "daemon wedged (\`rig daemon unwedge\` resumes it)" ;;
      unwedge) pkill -CONT -f "crowbar-api.real serve --host unix"; echo "daemon resumed" ;;
      nogit)
        case ${2:-on} in
          on) touch "$RIG_DIR/daemon.nogit" ;;
          off) rm -f "$RIG_DIR/daemon.nogit" ;;
          *) die "daemon nogit on|off" ;;
        esac
        old=$(pgrep -f "crowbar-api.real serve --host unix" || true)
        pkill -f "crowbar-api.real serve --host unix" || true
        for p in $old; do while kill -0 "$p" 2>/dev/null; do sleep 0.1; done; done
        "$0" _wait-daemon && echo "daemon restarted $([[ ${2:-on} == on ]] && echo without || echo with) git"
        ;;
      crashloop)
        case ${2:-on} in
          on) touch "$RIG_DIR/daemon.crashloop"; pkill -KILL -f "crowbar-api.real serve --host unix" || true; echo "daemon crash-looping" ;;
          off) rm -f "$RIG_DIR/daemon.crashloop"; echo "daemon crash loop off (the next start stays up)" ;;
          *) die "daemon crashloop on|off" ;;
        esac
        ;;
      *) die "daemon status|stop|start|restart|kill|wedge|unwedge|crashloop on|off|nogit on|off" ;;
    esac
    ;;
  seed)
    case ${1:-} in
      "" | list)
        echo "current: $(profile)"
        for t in "$PROFILES"/*.tar; do printf '  %-12s %s\n' "$(basename "$t" .tar)" "$(numfmt --to=iec "$(stat -c %s "$t")")"; done
        ;;
      *) seed_profile "$1" ;;
    esac
    ;;
  drag)
    # drag <app> <x1> <y1> <x2> <y2> [steps] [button] [hold-ms]: press, move in steps, release (XTest).
    one_app "${1:-}"
    w=$(activate "$1")
    x1=$2 y1=$3 x2=$4 y2=$5 steps=${6:-20} button=${7:-1} hold=${8:-150}
    xdotool mousemove --window "$w" "$x1" "$y1" mousedown "$button"
    sleep "$(awk -v ms="$hold" 'BEGIN { print ms / 1000 }')"
    for i in $(seq 1 "$steps"); do
      xdotool mousemove --window "$w" $((x1 + (x2 - x1) * i / steps)) $((y1 + (y2 - y1) * i / steps))
      sleep 0.02
    done
    sleep "$(awk -v ms="$hold" 'BEGIN { print ms / 1000 }')"
    xdotool mouseup "$button"
    ;;
  clip)
    # The CLIPBOARD selection, served by xclip until something else owns it.
    case ${1:-get} in
      set) printf '%s' "${2:?clip set <text>}" | xclip -selection clipboard -i ;;
      file)
        mime=${3:-$(python3 -c 'import mimetypes, sys; print(mimetypes.guess_type(sys.argv[1])[0] or "text/plain")' "${2:?clip file <path> [mime]}")}
        xclip -selection clipboard -t "$mime" -i "$2"
        ;;
      copy-file) # a file "copied" in a file manager: GNOME's target and a uri-list
        f=$(realpath "${2:?clip copy-file <path>}")
        printf 'copy\nfile://%s' "$f" | xclip -selection clipboard -t x-special/gnome-copied-files -i
        ;;
      uri) printf 'file://%s\r\n' "$(realpath "${2:?clip uri <path>}")" | xclip -selection clipboard -t text/uri-list -i ;;
      lines) xclip -selection clipboard -i "$HOME/fixtures/clipboard/lines.txt" ;;
      image) xclip -selection clipboard -t image/png -i "$HOME/fixtures/clipboard/image.png" ;;
      get) xclip -selection clipboard -o ${2:+-t "$2"} ;;
      targets) xclip -selection clipboard -o -t TARGETS ;;
      clear) printf '' | xclip -selection clipboard -i ;;
      *) die "clip set <text>|file <path> [mime]|copy-file <path>|uri <path>|lines|image|get [target]|targets|clear" ;;
    esac
    ;;
  http)
    case ${1:-status} in
      start)
        pgrep -f "fixture-http.py $HTTP_PORT" >/dev/null && { echo "http://127.0.0.1:$HTTP_PORT/ (already running)"; exit 0; }
        setsid python3 /opt/rig/bin/fixture-http.py "$HTTP_PORT" >>"$RIG_DIR/http.log" 2>&1 </dev/null &
        for _ in $(seq 50); do python3 -c "import urllib.request,sys; urllib.request.urlopen(sys.argv[1], timeout=1)" \
          "http://127.0.0.1:$HTTP_PORT/" 2>/dev/null && break; sleep 0.1; done
        echo "http://127.0.0.1:$HTTP_PORT/"
        ;;
      stop) pkill -f "fixture-http.py $HTTP_PORT" || true; echo "http fixture stopped" ;;
      status) pgrep -f "fixture-http.py $HTTP_PORT" >/dev/null && echo "http://127.0.0.1:$HTTP_PORT/ running" || echo "http fixture stopped" ;;
      url) echo "http://127.0.0.1:$HTTP_PORT/${2:-}" ;;
      *) die "http start|stop|status|url [path]" ;;
    esac
    ;;
  motion)
    # GTK's animation switch: WebKitGTK maps it to prefers-reduced-motion (Tauri, and the panes'
    # webview in the Rust shell). GPUI reads no OS motion setting on Linux. Apps restart to pick it up.
    case ${1:-} in
      reduced) v=false ;;
      full) v=true ;;
      *) die "motion reduced|full [app]" ;;
    esac
    ini=$HOME/.config/gtk-3.0/settings.ini
    read -ra targets <<<"$(apps_of "${2:-all}")"
    set_motion() { grep -v '^gtk-enable-animations=' "$ini" >"$ini.tmp"; echo "gtk-enable-animations=$v" >>"$ini.tmp"; mv "$ini.tmp" "$ini"; }
    with_stopped "${targets[@]}" -- set_motion
    echo "gtk-enable-animations=$v"
    ;;
  ime)
    # ibus with pinyin (CJK) on a session bus; the apps restart with GTK_IM_MODULE/XMODIFIERS set.
    case ${1:-status} in
      on)
        bus_up
        pgrep -r R,S,D -x ibus-daemon >/dev/null || (setsid env $(app_env) ibus-daemon --xim --daemonize --replace >>"$RIG_DIR/ibus.log" 2>&1)
        # The engine process starts lazily: setting it can report failure until it is up.
        for _ in $(seq 40); do
          env $(app_env) ibus engine "${2:-libpinyin}" 2>/dev/null || true
          [[ $(env $(app_env) ibus engine 2>/dev/null) == "${2:-libpinyin}" ]] && break
          sleep 0.25
        done
        env_set GTK_IM_MODULE ibus; env_set XMODIFIERS @im=ibus; env_set QT_IM_MODULE ibus
        read -ra targets <<<"$(apps_of all)"; with_stopped "${targets[@]}" -- true
        echo "ibus on, engine $(env $(app_env) ibus engine 2>/dev/null)"
        ;;
      engine) env $(app_env) ibus engine "${2:?ime engine <name>}" || true; echo "engine $(env $(app_env) ibus engine)" ;;
      engines) env $(app_env) ibus list-engine | grep -E 'pinyin|xkb:us' ;;
      off)
        pkill -x ibus-daemon || true
        env_clear GTK_IM_MODULE; env_clear XMODIFIERS; env_clear QT_IM_MODULE
        read -ra targets <<<"$(apps_of all)"; with_stopped "${targets[@]}" -- true
        echo "ibus off"
        ;;
      status) pgrep -r R,S,D -x ibus-daemon >/dev/null && echo "ibus on, engine $(env $(app_env) ibus engine 2>/dev/null)" || echo "ibus off" ;;
      *) die "ime on [engine]|off|engine <name>|engines|status" ;;
    esac
    ;;
  keys)
    # X keyboard layouts: a Compose key (Right Alt) and a layout with dead keys (us intl).
    case ${1:-} in
      compose) setxkbmap -layout us -option '' -option compose:ralt; echo "us, Compose on Right Alt" ;;
      deadkeys) setxkbmap -layout us -variant intl -option '' -option compose:ralt; echo "us intl (dead keys), Compose on Right Alt" ;;
      reset) setxkbmap -layout us -variant '' -option ''; echo "us" ;;
      show) setxkbmap -query ;;
      *) die "keys compose|deadkeys|reset|show" ;;
    esac
    ;;
  a11y)
    # AT-SPI: a session bus and the registry, and the apps restarted with their bridge on.
    case ${1:-status} in
      on)
        bus_up
        if ! pgrep -r R,S,D -f at-spi-bus-launcher >/dev/null; then
          (setsid env $(app_env) /usr/libexec/at-spi-bus-launcher --launch-immediately >>"$RIG_DIR/atspi.log" 2>&1 </dev/null &)
          sleep 1
        fi
        env_set NO_AT_BRIDGE; env_set GTK_A11Y atspi
        read -ra targets <<<"$(apps_of all)"; with_stopped "${targets[@]}" -- true
        echo "AT-SPI on"
        ;;
      off)
        env_clear GTK_A11Y; env_clear NO_AT_BRIDGE
        read -ra targets <<<"$(apps_of all)"; with_stopped "${targets[@]}" -- true
        echo "AT-SPI off"
        ;;
      dump)
        one_app "${2:-}"
        env $(app_env) python3 /opt/rig/bin/a11y-dump.py --pid "$(pid_of "$2")" "${@:3}"
        ;;
      apps) env $(app_env) python3 -c 'import pyatspi; [print(a.name, a.get_process_id()) for a in pyatspi.Registry.getDesktop(0) if a]' ;;
      status) grep -q '^-u NO_AT_BRIDGE$' "$RIG_DIR/app.env" 2>/dev/null && echo "AT-SPI on" || echo "AT-SPI off" ;;
      *) die "a11y on|off|dump <app> [--depth N]|apps|status" ;;
    esac
    ;;
  remote)
    # A second daemon on this container as a remote host: TLS on 0.0.0.0:$REMOTE_PORT, paired clients only.
    case ${1:-status} in
      start) remote_start; echo "remote host up: $(remote_addresses)" ;;
      stop) remote_stop; echo "remote host down" ;;
      restart) remote_stop; remote_start; echo "remote host up" ;;
      code) # a one-time pairing code and the fingerprint to enter in the app
        remote_pid >/dev/null || remote_start
        remote /opt/crowbar/crowbar-api.real pair
        echo "Address         $(remote_addresses)"
        ;;
      clients) remote python3 /opt/rig/bin/rigapi.py GET /v0/clients ;;
      revoke) # every paired client: the app's next call gets 401
        remote python3 - <<'PY'
import sys; sys.path.insert(0, "/opt/rig/bin")
import rigapi
api = rigapi.Api()
for c in api.get("/v0/clients") or []:
    api.delete(f"/v0/clients/{c['id']}")
    print("revoked", c["id"])
PY
        ;;
      rekey) # a new TLS key and certificate: the pinned fingerprint no longer matches
        remote_stop; rm -rf "$REMOTE_HOME/tls"; remote_start
        echo "remote host re-keyed: $(remote /opt/crowbar/crowbar-api.real pair | sed -n 's/^Fingerprint *//p')"
        ;;
      providers)
        case ${2:-} in
          off | on) remote python3 - "$2" <<'PY'
import sys; sys.path.insert(0, "/opt/rig/bin")
import rigapi
api = rigapi.Api()
cur = api.get("/v0/settings/chat/providers")
api.put("/v0/settings/chat/providers", {"providers": [
    {"id": p["id"], "disabled": sys.argv[1] == "off", "mcpDisabled": not p["mcpEnabled"]} for p in cur]})
print("remote providers", sys.argv[1])
PY
            ;;
          *) die "remote providers on|off" ;;
        esac
        ;;
      api) shift; remote python3 /opt/rig/bin/rigapi.py "$@" ;;
      wipe) remote_stop; rm -rf "$REMOTE_HOME" "$HOME/remote-host"; echo "remote host wiped (next start seeds it)" ;;
      status) remote_pid >/dev/null && echo "remote host up: $(remote_addresses)" || echo "remote host down" ;;
      *) die "remote start|stop|restart|code|clients|revoke|rekey|providers on|off|api ...|wipe|status" ;;
    esac
    ;;
  forge)
    # The forge CLI stand-ins (forge/forge as glab and gh): signed in or out, and what they report.
    case ${2:-all} in
      all) clis="glab gh" ;;
      glab | gh) clis=$2 ;;
      *) die "forge signed-in|signed-out|status [glab|gh|all]" ;;
    esac
    mkdir -p "$HOME/fixtures/forge"
    for cli in $clis; do
      case ${1:-status} in
        signed-in) rm -f "$HOME/fixtures/forge/$cli.signed-out"; echo "$cli: signed in" ;;
        signed-out) touch "$HOME/fixtures/forge/$cli.signed-out"; echo "$cli: signed out" ;;
        status)
          "$cli" auth status 2>&1 || true
          if [[ $cli == glab ]]; then glab mr list --state all --output json; else gh pr list --state all --json number,state,headRefName,baseRefName,url,title; fi |
            python3 -m json.tool 2>/dev/null || true
          ;;
