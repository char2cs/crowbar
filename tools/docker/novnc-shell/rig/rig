    done
    ;;
  pick) one_app "${1:-}"; pick "$1" "${2:?pick <app> <path>}" ;;
  fault)
    case ${1:-list} in
      clear) rm -f "$RIG_DIR/faults"; fault_signal; echo "faults cleared" ;;
      list) [[ -s $RIG_DIR/faults ]] && cat "$RIG_DIR/faults" || echo "no faults" ;;
      *) fault_add "$1" "${2:?fault <method> <path-regex> <status|drop|delay ms>}" "${3:-}" "${4:-}"; cat "$RIG_DIR/faults" ;;
    esac
    ;;
  api) python3 /opt/rig/bin/rigapi.py "$@" ;;
  ledger) python3 /opt/rig/bin/rigapi.py ledger "${1:?ledger <chat-id>}" ;;
  agent) python3 /opt/rig/bin/rigops.py "$@" ;;
  provider)
    case ${1:-list} in
      list) python3 /opt/rig/bin/rigapi.py GET /v0/settings/chat/providers |
        python3 -c 'import json,sys; [print("%-14s enabled=%-5s connected=%s" % (p["id"], p["enabled"], p["connected"])) for p in json.load(sys.stdin)]' ;;
      enable | disable)
        python3 - "$1" "${2:?provider enable|disable <id>}" <<'PY'
import json, subprocess, sys
verb, target = sys.argv[1], sys.argv[2]
cur = json.loads(subprocess.run(["python3", "/opt/rig/bin/rigapi.py", "GET", "/v0/settings/chat/providers"], capture_output=True, text=True, check=True).stdout)
prefs = [{"id": p["id"], "disabled": (verb == "disable") if p["id"] == target else not p["enabled"], "mcpDisabled": not p["mcpEnabled"]} for p in cur]
subprocess.run(["python3", "/opt/rig/bin/rigapi.py", "PUT", "/v0/settings/chat/providers", json.dumps({"providers": prefs})], check=True, capture_output=True)
print(f"{target} {verb}d")
PY
        ;;
      *) die "provider list|enable <id>|disable <id>" ;;
    esac
    ;;
  _daemon-loop)
    sock=$(socket)
    while true; do
      while [[ -e $RIG_DIR/daemon.paused ]]; do sleep 0.5; done
      if [[ -e $RIG_DIR/daemon.crashloop ]]; then
        # `rig daemon crashloop`: up for about 2 s, then SIGKILL, over and over.
        PATH=$(daemon_path) /opt/crowbar/crowbar-api.real serve --host "unix://$sock" >>"$RIG_DIR/daemon.log" 2>&1 &
        sleep 2
        kill -KILL $! 2>/dev/null || true
        wait $! 2>/dev/null || true
      else
        PATH=$(daemon_path) /opt/crowbar/crowbar-api.real serve --host "unix://$sock" >>"$RIG_DIR/daemon.log" 2>&1 || true
      fi
      sleep 1
    done
    ;;
  _session) # at boot: a fresh session bus for the apps (the file-chooser portal is D-Bus activated)
    rm -f "$RIG_DIR/bus.env"
    bus_up
    ;;
  _wait-daemon)
    for _ in $(seq 300); do python3 "$RIGX" health "$(socket)" >/dev/null 2>&1 && exit 0; sleep 0.2; done
    die "the daemon did not become healthy"
    ;;
  reset) reset_state ;;
  _extract-profile) extract_profile "${1:-$(profile)}" ;;
  help | -h | --help) usage ;;
  *) usage; die "unknown command '$sub'" ;;
esac
